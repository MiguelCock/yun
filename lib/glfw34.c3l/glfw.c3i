/*************************************************************************
 * GLFW API types
 *************************************************************************/
 
alias GlProc = fn void();
alias VkProc = fn void();
alias Monitor = void;
alias Window = void;
alias Cursor = void;

alias AllocateFn = fn void*(usz size, void* user);
alias ReallocateFn = fn void*(void* block, usz size, void* user);
alias DeallocateFn = fn void(void* block, void* user);
alias ErrorFn = fn void(int error_code, ZString description);

alias WindowPosFn            = fn void(Window* window, int xpos, int ypos);
alias WindowSizeFn           = fn void(Window* window, int width, int height);
alias WindowCloseFn          = fn void(Window* window);
alias WindowRefreshFn        = fn void(Window* window);
alias WindowFocusFn          = fn void(Window* window, int focused);
alias WindowIconifyFn        = fn void(Window* window, int iconified);
alias WindowMaximizeFn       = fn void(Window* window, int maximized);
alias FramebufferSizeFn      = fn void(Window* window, int width, int height);
alias WindowContentScaleFn   = fn void(Window* window, float xscale, float yscale);
alias MouseButtonFn          = fn void(Window* window, int button, int action, int mods);
alias CursorPosFn            = fn void(Window* window, double xpos, double ypos);
alias CursorEnterFn          = fn void(Window* window, int entered);
alias ScrollFn               = fn void(Window* window, double xoffset, double yoffset);
alias KeyFn                  = fn void(Window* window, int key, int scancode, int action, int mods);
alias CharFn                 = fn void(Window* window, uint codepoint);
alias CharModsFn             = fn void(Window* window, uint codepoint, int mods);
alias DropFn                 = fn void(Window* window, int path_count, ZString[] paths);
alias MonitorFn              = fn void(Monitor* monitor, int event);
alias JoystickFn             = fn void(int jid, int event);
 
struct VidMode
{
	int width;
	int height;
	int redBits;
	int greenBits;
	int blueBits;
	int refreshRate;
}

struct GammaRamp
{
	ushort* red;
	ushort* green;
	ushort* blue;
	uint size;
}
 
struct Image
{
	int width;
	int height;
	ZString pixels;
}
 
struct GamepadState
{
	char[15] buttons;
	float[6] axes;
}

struct Allocator
{
	AllocateFn allocate;
	ReallocateFn reallocate;
	DeallocateFn deallocate;
	void* user;
}

/*************************************************************************
 * GLFW API functions
 *************************************************************************/

fn int init() @cname("glfwInit");
fn void terminate() @cname("glfwTerminate");
fn void initHint(int hint, int value) @cname("glfwInitHint");
fn void initAllocator(Allocator* allocator) @cname("glfwInitAllocator");
fn void getVersion(int* major, int* minor, int* rev) @cname("glfwGetVersion");
fn ZString getVersionString() @cname("glfwGetVersionString");
fn int getError(String* description) @cname("glfwGetError");
fn ErrorFn setErrorCallback(ErrorFn callback) @cname("glfwSetErrorCallback");
fn int getPlatform() @cname("glfwGetPlatform");
fn int platformSupported(int platform) @cname("glfwPlatformSupported");

fn Monitor** getMonitors(int* count) @cname("glfwGetMonitors");
fn Monitor* getPrimaryMonitor() @cname("glfwGetPrimaryMonitor");
fn void getMonitorPos(Monitor* monitor, int* xpos, int* ypos) @cname("glfwGetMonitorPos");
fn void getMonitorWorkarea(Monitor* monitor, int* xpos, int* ypos, int* width, int* height) @cname("glfwGetMonitorWorkarea");
fn void getMonitorPhysicalSize(Monitor* monitor, int* widthMM, int* heightMM) @cname("glfwGetMonitorPhysicalSize");
fn void getMonitorContentScale(Monitor* monitor, float* xscale, float* yscale) @cname("glfwGetMonitorContentScale");
fn ZString getMonitorName(Monitor* monitor) @cname("glfwGetMonitorName");
fn void setMonitorUserPointer(Monitor* monitor, void* pointer) @cname("glfwSetMonitorUserPointer");
fn void* getMonitorUserPointer(Monitor* monitor) @cname("glfwGetMonitorUserPointer");
fn MonitorFn setMonitorCallback(MonitorFn callback) @cname("glfwSetMonitorCallback");
 
fn VidMode* getVideoModes(Monitor* monitor, int* count) @cname("glfwGetVideoModes");
fn VidMode* getVideoMode(Monitor* monitor) @cname("glfwGetVideoMode");
 
fn void setGamma(Monitor* monitor, float gamma) @cname("glfwSetGamma");
fn GammaRamp* getGammaRamp(Monitor* monitor) @cname("glfwGetGammaRamp");
fn void setGammaRamp(Monitor* monitor, GammaRamp* ramp) @cname("glfwSetGammaRamp");
 
fn void defaultWindowHints() @cname("glfwDefaultWindowHints");
fn void windowHint(int hint, int value) @cname("glfwWindowHint");
fn void windowHintString(int hint, ZString value) @cname("glfwWindowHintString");
fn Window* createWindow(int width, int height, ZString title, Monitor* monitor, Window* share) @cname("glfwCreateWindow");
fn void destroyWindow(Window* window) @cname("glfwDestroyWindow");
fn int windowShouldClose(Window* window) @cname("glfwWindowShouldClose");
fn void setWindowShouldClose(Window* window, int value) @cname("glfwSetWindowShouldClose");
fn ZString getWindowTitle(Window* window) @cname("glfwGetWindowTitle");
fn void setWindowTitle(Window* window, ZString title) @cname("glfwSetWindowTitle");
fn void setWindowIcon(Window* window, int count, Image* images) @cname("glfwSetWindowIcon");
fn void getWindowPos(Window* window, int* xpos, int* ypos) @cname("glfwGetWindowPos");
fn void setWindowPos(Window* window, int xpos, int ypos) @cname("glfwSetWindowPos");
fn void getWindowSize(Window* window, int* width, int* height) @cname("glfwGetWindowSize");
fn void setWindowSizeLimits(Window* window, int minwidth, int minheight, int maxwidth, int maxheight) @cname("glfwSetWindowSizeLimits");
fn void setWindowAspectRatio(Window* window, int numer, int denom) @cname("glfwSetWindowAspectRatio");
fn void setWindowSize(Window* window, int width, int height) @cname("glfwSetWindowSize");
fn void getFramebufferSize(Window* window, int* width, int* height) @cname("glfwGetFramebufferSize");
fn void getWindowFrameSize(Window* window, int* left, int* top, int* right, int* bottom) @cname("glfwGetWindowFrameSize");
fn void getWindowContentScale(Window* window, float* xscale, float* yscale) @cname("glfwGetWindowContentScale");
fn float getWindowOpacity(Window* window) @cname("glfwGetWindowOpacity");
fn void setWindowOpacity(Window* window, float opacity) @cname("glfwSetWindowOpacity");
fn void iconifyWindow(Window* window) @cname("glfwIconifyWindow");
fn void restoreWindow(Window* window) @cname("glfwRestoreWindow");
fn void maximizeWindow(Window* window) @cname("glfwMaximizeWindow");
fn void showWindow(Window* window) @cname("glfwShowWindow");
fn void hideWindow(Window* window) @cname("glfwHideWindow");
fn void focusWindow(Window* window) @cname("glfwFocusWindow");
fn void requestWindowAttention(Window* window) @cname("glfwRequestWindowAttention");
fn Monitor* getWindowMonitor(Window* window) @cname("glfwGetWindowMonitor");
fn void setWindowMonitor(Window* window, Monitor* monitor, int xpos, int ypos, int width, int height, int refreshRate) @cname("glfwSetWindowMonitor");
fn int getWindowAttrib(Window* window, int attrib) @cname("glfwGetWindowAttrib");
fn void setWindowAttrib(Window* window, int attrib, int value) @cname("glfwSetWindowAttrib");
fn void setWindowUserPointer(Window* window, void* pointer) @cname("glfwSetWindowUserPointer");
fn void* getWindowUserPointer(Window* window) @cname("glfwGetWindowUserPointer");
fn WindowPosFn setWindowPosCallback(Window* window, WindowPosFn callback) @cname("glfwSetWindowPosCallback");
fn WindowSizeFn setWindowSizeCallback(Window* window, WindowSizeFn callback) @cname("glfwSetWindowSizeCallback");
fn WindowCloseFn setWindowCloseCallback(Window* window, WindowCloseFn callback) @cname("glfwSetWindowCloseCallback");
fn WindowRefreshFn setWindowRefreshCallback(Window* window, WindowRefreshFn callback) @cname("glfwSetWindowRefreshCallback");
fn WindowFocusFn setWindowFocusCallback(Window* window, WindowFocusFn callback) @cname("glfwSetWindowFocusCallback");
fn WindowIconifyFn setWindowIconifyCallback(Window* window, WindowIconifyFn callback) @cname("glfwSetWindowIconifyCallback");
fn WindowMaximizeFn setWindowMaximizeCallback(Window* window, WindowMaximizeFn callback) @cname("glfwSetWindowMaximizeCallback");
fn FramebufferSizeFn setFramebufferSizeCallback(Window* window, FramebufferSizeFn callback) @cname("glfwSetFramebufferSizeCallback");
fn WindowContentScaleFn setWindowContentScaleCallback(Window* window, WindowContentScaleFn callback) @cname("glfwSetWindowContentScaleCallback");
 
fn void pollEvents() @cname("glfwPollEvents");
fn void waitEvents() @cname("glfwWaitEvents");
fn void waitEventsTimeout(double timeout) @cname("glfwWaitEventsTimeout");
fn void postEmptyEvent() @cname("glfwPostEmptyEvent");
 
fn int getInputMode(Window* window, int mode) @cname("glfwGetInputMode");
fn void setInputMode(Window* window, int mode, int value) @cname("glfwSetInputMode");
fn int rawMouseMotionSupported() @cname("glfwRawMouseMotionSupported");
